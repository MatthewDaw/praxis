.idea/
# .claude/ holds per-machine local state (settings.local.json carries live API keys,
# worktrees/ is git-internal) that must never be tracked — EXCEPT commands/, which are
# project-local slash-command definitions meant to ship with the repo (so a fresh clone,
# or the EC2 devbox, gets /af-build-remote-jobs and /af-super-run without hand-setup).
.claude/*
!.claude/commands/
.specify/
.gstack/

# Microsoft Office lock/temp files
~$*

# Generated eval baselines
knowledge/evals/results/*.jsonl

# Verbose per-run eval transcripts (raw agent/judge responses)
knowledge/evals/results/runs/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Secrets / local env
.env
frontend-react/.env.local

# CDK build artifacts
node_modules/
infra/node_modules/
infra/cdk.out/
infra/cdk.context.json

# Server runtime data (persisted candidate store)
knowledge/serve/data/

# Large reference data & media — host externally (e.g. S3), never push to git.
# (Readers currently read these from local paths; an S3 move would change that.)
# The assets/ dir holds the bulk (videos, extracted frames, subtitles); the
# extension globals are scoped under it to avoid catching frontend/docs images.
knowledge/assets/
knowledge/**/*.mp4
knowledge/**/*.webp
knowledge/**/*.vtt
.worktrees
scratch_graph.json

# Generated Monica demo video capture outputs
docs/monica/videos/experiment-video-capture-*/BL_proxy/

# SWE-rebench eval pilot grader artifacts (written to cwd on a live run)
logs/run_evaluation/
preds_*.json

# Local backend serve logs
backend-serve.log
backend-serve.err.log
.venv/

# Per-run build-loop lock. af-ticket-loop.sh rewrites this on every run, so tracking it made
# the worktree permanently dirty for the duration of a build -- and af-verify-and-push.sh refuses
# a dirty tree, so the two tools deadlocked: the push half could never run while a build was
# running, which is exactly when the loop tells you to run it.
.af-loop.lock
